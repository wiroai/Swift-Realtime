// Copy this file to Secrets.xcconfig (gitignored) and fill in values.
// WIRO_API_KEY is required. WIRO_API_SECRET is only for signature
// projects.

WIRO_API_KEY = your-api-key
WIRO_API_SECRET =

// Your Apple Developer team id, needed to run on a physical iPhone.
// Keeping it here rather than in the project file means Xcode never
// dirties project.pbxproj with a personal team.
DEVELOPMENT_TEAM =
